# Token GitHub (Fine-Grained PAT, butuh Contents+Issues Read-only).
# Di Vercel: isi via dashboard Project > Settings > Environment Variables.
# Jangan commit file .env asli.
GITHUB_PAT=

# Lama cache server (detik). Default 720 = 12 menit.
CACHE_TTL_SECONDS=720

# Token TULIS terpisah (JANGAN pakai GITHUB_PAT read-only untuk aksi tulis).
# Fine-grained PAT, izin minimal: Issues Read & write + Projects Read & write.
GITHUB_WRITE_PAT=

# Secret verifikasi webhook (bebas, 32+ char acak). Disimpan server saja.
GITHUB_WEBHOOK_SECRET=
